# Keep the Docker build context small: the Dockerfile only COPYs
# Cargo.toml/Cargo.lock, pyproject.toml/uv.lock/setup.py/README.md,
# build_support/, bot/, crates/, openviking/, openviking_cli/, src/,
# third_party/, web-studio/ and docker/.

# VCS
.git
.github

# Build artifacts
target
**/target
build
dist
*.egg-info
src/cmake_build
src/build
**/__pycache__
**/*.pyc

# Node
**/node_modules

# Local state / data
data
.pytest_cache
.coverage
htmlcov
.venv

# Non-build directories
benchmark
deploy
docs
examples
play
playground
sdk
tests
web-studio/dist
# 本地预构建的前端产物：必须排除，否则 setup.py 会跳过 web-studio 重新构建，
# 把过期的 dist 打进镜像
openviking/web_studio/dist
npm
